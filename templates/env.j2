PUID={{ prowlarr_uid }}
PGID={{ prowlarr_gid }}
TZ={{ prowlarr_environment_variables_tz }}

{# Prowlarr takes its port from the `config.xml` it maintains for itself under
   `prowlarr_data_path`, which this role does not template. Without this override
   the container would keep listening on Prowlarr's built-in 9696 no matter what
   `prowlarr_container_http_port` says, while the port publishing and the Traefik
   labels would point at the configured port and find nothing there. #}
PROWLARR__SERVER__PORT={{ prowlarr_container_http_port }}

{# Traefik passes the prefix through rather than stripping it (see `labels.j2`).
   `/` means the root. #}
PROWLARR__SERVER__URLBASE={{ prowlarr_path_prefix }}

{{ prowlarr_environment_variables_additional_variables }}
